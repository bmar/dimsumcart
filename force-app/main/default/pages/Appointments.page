<apex:page Controller="AppointmentsController" action="{!setLocate}" sidebar="false" standardStylesheets="false" showHeader="false" docType="html-5.0" applyHtmlTag="false">

<html lang="en">
<head>
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
    <!-- apex:slds / -->
    <style>
        .message {
        background-color: #c00; /* change background color here */  
        border-style: solid;
        border-width: 1px;
        color: #000;
        padding: 6px 8px 6px 8px;
        margin: 4px 20px;
        color: white;
        }
        .message .messageText {
        margin-left: 8px;
        color: white; /* change fonnt color here */
        }
        .slds-scope .slds-button_success {
        background-color: #428BCA;
        border-color: #428BCA;
        color: white;
        width: 50%;
        margin-bottom: 100px;
        }
        label {
        font-weight: bold;
        }
        .slds-brand-band > div { margin: 1rem 1rem 0 1rem; padding: 0 1rem;}
        @media (min-width: 576px) {
            .slds-brand-band > div, .slds-scope .slds-button_success {width:48rem;}
            .slds-brand-band > div {    margin: 5rem auto 1rem; padding: 0;}
        }
    </style>
   
