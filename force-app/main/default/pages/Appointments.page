<body>
    <apex:form id="frm">
<apex:inputHidden id="firstname" value="{!leadw.cu_FirstName}" />
<apex:inputHidden id="lastname" value="{!leadw.cu_LastName}" />
<apex:inputHidden id="email" value="{!leadw.cu_Email}" />
<apex:inputHidden id="phone" value="{!leadw.cu_PhoneNumber}" />
<apex:inputHidden id="street" value="{!leadw.cu_street}" />
<apex:inputHidden id="city" value="{!leadw.cu_city}" />
<apex:inputHidden id="zip" value="{!leadw.cu_postalcode}" />
<apex:inputHidden id="territory" value="{!leadw.cu_territory}" />
<apex:inputHidden id="date" value="{!leadw.cu_appointmentDate}" />
<apex:inputHidden id="time" value="{!leadw.cu_appointmentTime}" />
<apex:inputHidden id="product" value="{!leadw.cu_serviceType}" />
<apex:inputHidden id="affirmconsent" value="{!leadw.cu_isAffirmedConsent}" />
<apex:inputHidden id="howfind" value="{!leadw.cu_howfind}" />
<apex:outputPanel rendered="{!isPavers == false}">
    <input type="hidden" id="redirectTo" name="redirectTo" value="https://cmkconstructioninc.com/thank-you-appointment?utm_content={!lead_source}"/>
</apex:outputPanel>
<apex:outputPanel rendered="{!isPavers}">
    <input type="hidden" id="redirectTo" name="redirectTo" value="https://cmkconstructioninc.com/thank-you-appointment?utm_content={!lead_source}"/>
</apex:outputPanel>
<input type="hidden" id="form_url" name="form_url" value="https://cmkconstructioninc.my.salesforce-sites.com/appointment?locate="/>
        <apex:actionFunction name="doAction" action="{!doSubmit}" />
        <apex:actionFunction name="doReload" action="{!setLocate}" />
<!-- <apex:commandButton value="Submit" action="{!doSubmit}"/> rerender="frm" -->
    </apex:form>

    <div class="slds-brand-band slds-brand-band_medium slds-brand-band_cover"> 
        <div>
            <apex:outputPanel rendered="{!isPavers == false}"> 
                <div style="margin-bottom:1rem">
                    <img src="https://www.cmkconstructioninc.com/img/logo-dark.png"/>
                </div>
                <div class="slds-text-heading_medium"><b>Appointment Booking</b></div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!isPavers}"> 
                <div style="margin-bottom:1rem">
                    <img src="https://www.cmkconstructioninc.com/img/logo-dark.png"/>
                </div>
                <div class="slds-text-heading_medium"><b>Appointment Booking</b></div>
            </apex:outputPanel>
            <br/>
            <apex:outputPanel rendered="{!cu_found}">
                <div class=".slds-text-body_regular">
                    <p>Dear {!leadw.cu_FirstName} {!leadw.cu_LastName},</p>
                    <p>Your appointment is already booked with us. If anything changes on your end please text us here, or email us at hello@cmkconstructioninc.com, or dial (619) 371-9870.</p>
                    <p>We require that we meet with both homeowners if applicable so as to go over all details and concerns to provide an accurate quote.</p>
                </div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!cu_found == false}">
                <div class="slds-text-heading_small">
                    Please pick a convenient date and time below when we can meet with you <b>and any additional home owners.</b> Please also review and update your contact details if needed.  Thank you!
                </div>
            </apex:outputPanel>
        </div>
    </div>
    
    <apex:outputPanel rendered="{!cu_found == false}">
    <div id="app"></div>
        <script>
        if (document.location.search.indexOf("locate=") < 0) doReload();
        document.getElementById("form_url").value = document.location.href.substring(0,2047);
        </script>
