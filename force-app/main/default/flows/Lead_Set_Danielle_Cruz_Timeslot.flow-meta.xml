<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <description>Use Danielle Cruz Time Slot sub flow</description>
    <environments>Default</environments>
    <formulas>
        <name>fApptDateTime</name>
        <dataType>DateTime</dataType>
        <expression>CASE({!$Record.Location__c},
&quot;Arizona&quot;, {!varTimeZoneAdjusted},
&quot;Dallas&quot;, {!$Record.Appointment_Date_Time__c}+(2/24),
{!$Record.Appointment_Date_Time__c}
)</expression>
    </formulas>
    <formulas>
        <name>fDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.Appointment_Date_Time__c})</expression>
    </formulas>
    <interviewLabel>Lead - Set Danielle Cruz Slot {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Set Danielle Cruz Timeslot</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Time_Slots</name>
        <label>Set Time Slots</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Appointment_Date__c</field>
            <value>
                <elementReference>Get_Danielle_Cruz_Time_Slot_Flow.varApptDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Appointment_Time__c</field>
            <value>
                <elementReference>Get_Danielle_Cruz_Time_Slot_Flow.varApptTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Danielle_Cruz_Time_Slot_Flow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Appointment_Date_Time__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Appointment_Date_Time__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Get_Danielle_Cruz_Time_Slot_Flow</name>
        <label>Get Danielle Cruz Time Slot Flow</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Set_Time_Slots</targetReference>
        </connector>
        <flowName>Get_Danielle_Cruz_Time_Slot</flowName>
        <inputAssignments>
            <name>varApptDateTime</name>
            <value>
                <elementReference>$Record.Appointment_Date_Time__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varLocation</name>
            <value>
                <elementReference>$Record.Location__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varObject</name>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>varTimeZoneAdjusted</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
