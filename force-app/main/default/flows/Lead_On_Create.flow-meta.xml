    <description>Added Dallas GMT conversion</description>
    <environments>Default</environments>
    <formulas>
        <name>fCompany</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.FirstName} + &apos; &apos; + {!$Record.LastName})</expression>
    </formulas>
    <formulas>
        <name>fDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE( TEXT(DATE(YEAR({!$Record.Appointment_Date__c}), MONTH({!$Record.Appointment_Date__c}), DAY({!$Record.Appointment_Date__c}))) &amp; &apos; &apos; &amp; IF(
  AND(
    OR(LEFT(TEXT({!$Record.Appointment_Time__c}),1) &lt;&gt; &apos;1&apos;,LEFT(TEXT({!$Record.Appointment_Time__c}),2) = &apos;1:&apos;),
    VALUE(LEFT(TEXT({!$Record.Appointment_Time__c}),1))&lt;8
  ),
  TEXT(VALUE(LEFT(TEXT({!$Record.Appointment_Time__c}),1))+12), 
  LEFT(TEXT({!$Record.Appointment_Time__c}),FIND(&apos;:&apos;,TEXT({!$Record.Appointment_Time__c}))-1)
) &amp; MID(TEXT({!$Record.Appointment_Time__c}),FIND(&apos;:&apos;,TEXT({!$Record.Appointment_Time__c})),3) &amp; &apos;:00&apos;
) + (IF(
  AND(
    {!$Record.Appointment_Date__c} &gt;= DATE( YEAR({!$Record.Appointment_Date__c}), 3,(2*7+1)) - WEEKDAY(DATE(YEAR({!$Record.Appointment_Date__c}), 3,8-1)),
    {!$Record.Appointment_Date__c} &lt;= DATE( YEAR({!$Record.Appointment_Date__c}),11,(1*7+1)) - WEEKDAY(DATE(YEAR({!$Record.Appointment_Date__c}),11,8-1))
  ),
/*DST is true*/
  CASE({!$Record.Location__c},
    &quot;Dallas&quot;,5,
    7
  ),
/*DST is False*/
  CASE({!$Record.Location__c},
    &quot;Dallas&quot;, 6,
    8
  )
))/24</expression>
    </formulas>
