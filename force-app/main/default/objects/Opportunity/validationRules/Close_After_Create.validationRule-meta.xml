<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Close_After_Create</fullName>
    <active>true</active>
    <errorConditionFormula>CloseDate &lt; (IF(ISNULL(CreatedDate), TODAY() , DATEVALUE(CreatedDate)))</errorConditionFormula>
    <errorDisplayField>CloseDate</errorDisplayField>
    <errorMessage>Close Date cannot be earlier than Create Date</errorMessage>
</ValidationRule>
